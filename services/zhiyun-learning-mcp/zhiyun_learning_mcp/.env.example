# Copy this file to .env and fill in real values locally. Never commit secrets.

# --- MySQL: upstream source table and Meeting Assistant derived tables ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=<your-mysql-password>
MYSQL_DATABASE=zhiyun_learning
# Enable only when the MySQL server requires TLS. Keep verification enabled when possible.
MYSQL_SSL_REQUIRED=false
MYSQL_SSL_VERIFY=true
MYSQL_SSL_CA=

# --- Milvus ---
MILVUS_URI=http://localhost:19530
MILVUS_DB=zhiyun_learning
MILVUS_TOKEN=
MILVUS_COLLECTION_PREFIX=zyk_learning_

# --- OpenAI-compatible AI provider (Volcano Engine Ark in production) ---
AI_API_KEY=<your-ark-api-key>
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBED_MODEL=doubao-embedding-text-240715
# Must equal len(first_embedding_response.data[0].embedding) and the Milvus schema dimension.
EMBEDDING_DIM=2560
EXTRACT_MODEL=deepseek-v4-flash-ga-260731
LLM_TIMEOUT_SECONDS=120

# Legacy DASHSCOPE_API_KEY / DASHSCOPE_BASE remain accepted as fallbacks.

# --- MCP service ---
MCP_PORT=8768
INGEST_API_PORT=8769
# MCP authentication is always required; there is no default-user fallback setting.

# --- Zhiyun Keji controlled learning-result callback ---
# Use host.docker.internal when this MCP runs in Docker and the platform runs on Windows.
PLATFORM_PUBLIC_URL=http://host.docker.internal:18910
# Must match PLATFORM_WRITE_TOKEN in the platform .env when a token is enabled.
PLATFORM_WRITE_TOKEN=

# --- Concurrency ---
LLM_CONCURRENCY=8
RECORDING_CONCURRENCY=4
DB_POOL_SIZE=16
DB_ACQUIRE_TIMEOUT_SECONDS=10
DB_CONNECT_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800

# --- Upstream notification; worker reads the two MySQL source tables directly ---
INGEST_POLL_INTERVAL_SECONDS=2
INGEST_MAX_ATTEMPTS=5
INGEST_WORKER_CONCURRENCY=4
INGEST_JOB_LEASE_SECONDS=600
INGEST_JOB_HEARTBEAT_SECONDS=60
INGEST_RECORDING_LOCK_TIMEOUT_SECONDS=1
INGEST_FACT_LOCK_TIMEOUT_SECONDS=120
