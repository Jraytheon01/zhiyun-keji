# Platform
PLATFORM_HOST=127.0.0.1
PLATFORM_PORT=18910
PLATFORM_DATA_DIR=./data
ENABLE_DEMO_RESULT=true

# Existing course MySQL. Leave MYSQL_HOST empty to use bundled demo courses.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=zhiyun_learning
# Competition UI defaults to education records; set true only for raw-data diagnostics.
SHOW_NON_EDUCATION_RECORDS=false

# Existing ingest notification API (optional)
INGEST_API_URL=http://127.0.0.1:8769

# OpenAI-compatible AI service. Keep the key only on the server.
AI_API_KEY=
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_MODEL=deepseek-v4-flash-ga-260731

# TeleAgent local receiver from moben-monitor (optional)
# 项目副本 Receiver 的独立端口；Docker 运行平台时使用 host.docker.internal。
TELEAGENT_RECEIVER_URL=http://127.0.0.1:18768
TELEAGENT_RECEIVER_TOKEN=

# Optional internal callback token used by the MCP result-write tool.
PLATFORM_WRITE_TOKEN=
# MCP 在 Docker 内运行时改为 http://host.docker.internal:18910
PLATFORM_PUBLIC_URL=http://127.0.0.1:18910
